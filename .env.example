TELEGRAM_BOT_TOKEN=put_your_bot_token_here
ALLOWED_USER_IDS=put_your_telegram_user_id_here
OPENAI_API_KEY=put_your_api_key_here
# Optional read-only preflight uses an organization Admin API key and project ID.
OPENAI_ADMIN_KEY=
OPENAI_PROJECT_ID=
# Optional: when selected, OpenRouter handles transcription, translation, and TTS.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
OPENROUTER_TTS_MODEL=google/gemini-3.8-flash-lite-tts
OPENROUTER_TTS_VOICE=Kore
# Paid provider endpoints have provider-specific limits; pace conservatively by default.
OPENROUTER_RPM_LIMIT=10
OPENROUTER_MAX_RETRIES=8
# If omitted, the first ALLOWED_USER_IDS entry controls /provider.
PROVIDER_CONTROL_USER_ID=
# Automatically defaults to OpenRouter when its key is set; can be changed with /provider.
DEFAULT_API_PROVIDER=
TRANSLATION_MODEL=gpt-6-luna
WHISPER_MODEL=whisper-1
VIDEO_MAX_MINUTES=60
VIDEO_MAX_HEIGHT=720
MAX_FILE_BYTES=1000000000
WORK_DIR=/data
# Set to /run/secrets/youtube-cookies.txt only after mounting a cookies file.
YOUTUBE_COOKIES_FILE=
# Optional Instagram cookies, kept separate from the YouTube account.
INSTAGRAM_COOKIES_FILE=
YTDLP_POT_BASE_URL=http://pot-provider:4416
DOWNLOAD_BASE_URL=https://downloads.example.com
# Used only with docker-compose.https.yml; hostname only, no https:// or path.
DOWNLOAD_HOST=downloads.example.com
DOWNLOAD_TTL_HOURS=24
TTS_MODEL=gpt-realtime-2.1-mini
TTS_VOICE=marin
# Optional watermark on processed videos (top-left). Leave empty to disable.
WATERMARK_TEXT=
# Initial prices in Toman; prices can be changed in the Telegram /admin panel.
DEFAULT_SUBTITLE_PRICE_TOMAN_PER_MINUTE=5000
DEFAULT_DUB_PRICE_TOMAN_PER_MINUTE=10000
# Docker Compose starts the smart dubbing separator by default.
DUB_SEPARATOR_URL=http://dub-separator:8090
# Card-to-card transfer details, shown to users who request a top-up.
CARD_TO_CARD_NUMBER=
CARD_TO_CARD_HOLDER=
MINIMUM_WALLET_TOPUP_TOMAN=50000
# Public Telegram username for purchase support (without @).
SUPPORT_USERNAME=
POSTGRES_PASSWORD=replace_with_a_random_secret
