FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DEFAULT_TIMEOUT=180 PIP_RETRIES=8 \
    HF_HOME=/models/huggingface HF_HUB_DISABLE_XET=1 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 libgomp1 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# CPU wheels are published for both amd64 and arm64.
RUN python -m pip install --index-url https://download.pytorch.org/whl/cpu torch==2.8.0+cpu \
    && python -m pip install https://github.com/JusperLee/Dynamic-Band-Splitting/archive/ff526463a58ee0278e7bd05c4b8bce112b743e34.tar.gz
RUN useradd --create-home --uid 10001 appuser
WORKDIR /app
COPY separator/server.py /app/server.py
USER appuser
CMD ["python", "/app/server.py"]
